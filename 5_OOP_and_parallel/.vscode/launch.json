{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug main",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/build/main",
            "args": [],

            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",

            "externalConsole": false,

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerArgs": "-q -nx -iex \"set debuginfod enabled off\"",

            "setupCommands": [
                {
                    "description": "Disable debuginfod",
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable auto loading shared library symbols",
                    "text": "set auto-solib-add off",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable pagination",
                    "text": "set pagination off",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],

            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],

            "preLaunchTask": "build debug"
        },
        {
            "name": "Debug main with program.txt",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/build/main",
            "args": [
                "${workspaceFolder}/program.txt"
            ],

            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",

            "externalConsole": false,

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerArgs": "-q -nx -iex \"set debuginfod enabled off\"",

            "setupCommands": [
                {
                    "description": "Disable debuginfod",
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable auto loading shared library symbols",
                    "text": "set auto-solib-add off",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable pagination",
                    "text": "set pagination off",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],

            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],

            "preLaunchTask": "build debug"
        }
    ]
}